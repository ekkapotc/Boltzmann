From 2cfdef976ce2013d6abfb997bd492a0f0938b0bb Mon Sep 17 00:00:00 2001
From: Ekkapot Charoenwanit <ekkapot.c@tggs.kmutnb.ac.th>
Date: Fri, 11 Sep 2026 13:32:46 +0000
Subject: [PATCH] Let the suite run more ranks than there are cores

Open MPI refuses -np larger than the core count and needs --oversubscribe;
MPICH has no such rule and rejects the flag.  Detect which mpirun is on the
path and pass the flag only where it exists, overridable as MPIRUN_FLAGS.

Verified at 5, 6, 7, 8, 11 and 16 ranks on a two-core box: invariants 7 rows
0 failures, fdcheck 48/48, regress 55/55, lorenz PASS at every count.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FyuJajmMzkHXNaUcrpG99k
---
 Makefile           | 41 ++++++++++++++++++++++++++++++++++++++---
 examples/common.mk | 10 ++++++++--
 2 files changed, 46 insertions(+), 5 deletions(-)

diff --git a/Makefile b/Makefile
index f04a44b..0661d4e 100644
--- a/Makefile
+++ b/Makefile
@@ -34,8 +34,8 @@
 #   make clean      remove build/
 #
 # Ported from Maxwell's build tree, with one addition: NP.  Every example is
-# launched through $(MPIRUN) -np $(NP), so the whole suite can be moved to a
-# different rank count from the command line -- make test NP=8.
+# launched through $(MPIRUN) $(MPIRUN_FLAGS) -np $(NP), so the whole suite can
+# be moved to a different rank count from the command line -- make test NP=8.
 #
 BUILD_DIR := $(CURDIR)/build
 export BUILD_DIR
@@ -49,7 +49,35 @@ CXX := mpic++
 endif
 MPIRUN    ?= mpirun
 NP        ?= 2
-export CXX MPIRUN NP
+
+# ------------------------------------------------------- oversubscribing ---
+#
+# Open MPI (and the PRRTE runtime behind Open MPI 5) refuses -np larger than
+# the number of cores it can see, and dies with
+#
+#     There are not enough slots available in the system to satisfy the N
+#     slots that were requested by the application
+#
+# -- which on Debian and Ubuntu often prints instead as "Sorry! ... I couldn't
+# open the help file ... help-prte-rmaps-base.txt", because those packages ship
+# the runtime without its message catalogue.  That second message is a
+# packaging gap, not a fault in the program being launched; the real complaint
+# is the slot count.  --oversubscribe lifts the rule.
+#
+# MPICH's Hydra has no such rule and rejects the flag, so this cannot simply be
+# hard-coded.  Ask mpirun which it is, once, and pass the flag only where it
+# exists.  Set MPIRUN_FLAGS on the command line to override the guess, or to
+# empty to disable it:  make ranks MPIRUN_FLAGS=
+#
+# Oversubscribing is for testing the rank-count invariant, not for measuring
+# anything.  Ranks in this library block in MPI_Probe waiting for the hop
+# upstream, and a blocked rank sharing a core with a working one is a rank the
+# scheduler keeps waking for nothing.  Expect it to be slow, and do not read a
+# timing off it.
+#
+MPIRUN_FLAGS ?= $(shell $(MPIRUN) --version 2>&1 | grep -qi 'open[ -]*mpi' && echo --oversubscribe)
+
+export CXX MPIRUN MPIRUN_FLAGS NP
 
 STD       ?= -std=gnu++0x
 WARN      ?= -Wall -Wextra
@@ -83,6 +111,12 @@ list:
 # rank recorded some of them, so at np>1 it is a statement about the
 # pipeline rather than about a tape that happened to fit.
 #
+# More ranks than cores is fine and is worth doing -- a partition count that
+# does not divide the rank count exercises the ring's tail -- but see
+# MPIRUN_FLAGS above before raising this past nproc:
+#
+#     make ranks RANK_COUNTS="1 2 3 4 5 7 8"
+#
 RANK_EXAMPLES ?= invariants fdcheck regress lorenz
 RANK_COUNTS   ?= 1 2 3 4
 
@@ -129,6 +163,7 @@ help:
 	@echo "make            build build/lib/libboltzmann.a and every example into build/bin"
 	@echo "make test       build, then run the whole suite at NP=$(NP) ranks"
 	@echo "make ranks      run the assertion suites at $(RANK_COUNTS) ranks"
+	@echo "                more ranks than cores: make ranks RANK_COUNTS=\"1 2 4 8\""
 	@echo "make list       list the examples and the arguments they run with"
 	@echo "make sanitize   rebuild into build-asan/ under ASan and run: $(SAN_EXAMPLES)"
 	@echo "make clean      remove build/ and build-asan/"
diff --git a/examples/common.mk b/examples/common.mk
index 215dffe..77d8074 100644
--- a/examples/common.mk
+++ b/examples/common.mk
@@ -44,6 +44,12 @@ CXX := mpic++
 endif
 MPIRUN     ?= mpirun
 NP         ?= 2
+
+# Set and exported by ../../Makefile, which explains what it is for.  The
+# fallback is here so that `make run` works in an example directory on its own,
+# without going through the top-level Makefile: Open MPI needs --oversubscribe
+# to accept -np greater than the core count, MPICH rejects the flag.
+MPIRUN_FLAGS ?= $(shell $(MPIRUN) --version 2>&1 | grep -qi 'open[ -]*mpi' && echo --oversubscribe)
 BASE_FLAGS ?= -g -std=gnu++0x -Wall -Wextra
 EXTRA_FLAGS ?=
 FLAGS       = $(BASE_FLAGS) $(EXTRA_FLAGS)
@@ -68,10 +74,10 @@ $(OBJ_DIR) $(BIN_DIR):
 	@mkdir -p $@
 
 run: all
-	$(MPIRUN) -np $(NP) $(PROG) $(RUNARGS)
+	$(MPIRUN) $(MPIRUN_FLAGS) -np $(NP) $(PROG) $(RUNARGS)
 
 echo-args:
-	@echo "-np $(NP) $(RUNARGS)"
+	@echo "$(MPIRUN_FLAGS) -np $(NP) $(RUNARGS)"
 
 clean:
 	@rm -rf $(OBJ) $(PROG) test.*.er output*.txt job.sh core* *.btr *.o main
-- 
