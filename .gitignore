# Everything generated.  `make clean` is `rm -rf build`, and nothing is ever
# written into the source tree, so this list is short by design.
build/
build-asan/

# ...except when someone builds an example the old way, in its own directory.
*.o
*.a
core*

# Binaries the pre-build-tree Makefiles left beside their sources.  The suite
# builds into build/bin/<name> now, one per directory, so these are stale the
# moment they appear.  (test/ was renamed to examples/; the old spelling is
# kept so a stale checkout's leftovers are still ignored.)
test/*/main
examples/*/main

# Sun/Oracle Studio collector output and the job scripts the cluster runs.
examples/*/test.*.er/
examples/*/output*.txt
examples/*/job.sh
examples/*/*.btr

# Transient notes from tooling, not part of the library.
Makefile.new
*/Makefile.new
*/*/Makefile.new
INSTALL-MAKEFILES.txt
paa_fixes.diff
Claude outputs/
